    <!-- FAQ ACCORDION SECTION -->
    <section class="py-5">
      <div class="container max-w-900">
        <!-- Live Instant Search Box directly below Hero -->
        <div class="mb-4">
          <div class="input-group input-group-lg shadow-sm">
            <span class="input-group-text bg-surface border-subtle text-primary"><i class="bi bi-search"></i></span>
