/* ==========================================================================
   AURA FINISHES & CO. — MASTER RESPONSIVE STYLESHEET (responsive.css)
   Universal device compatibility from 280px (Galaxy Z Fold 5) up to 4K Ultra-Wide
   Optimized for: iPhone SE, XR, 12 Pro, 14/15/16 Pro Max, Pixel 7/8/9/10,
   Galaxy S8+, S20 Ultra, iPad Mini, Air, Pro, Surface Pro 7, Duo, Fold 5
   ========================================================================== */

/* --------------------------------------------------------------------------
   0. UNIVERSAL RESET, OVERFLOW GUARDS & FLUID TYPOGRAPHY TOKENS
   -------------------------------------------------------------------------- */
html, body {
  margin: 0 !important;
  padding: 0 !important;
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
  position: relative;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

*, *::before, *::after {
  box-sizing: border-box;
}

img, video, canvas, svg, iframe {
  max-width: 100%;
  height: auto;
  vertical-align: middle;
}

pre, code, kbd, samp {
  max-width: 100%;
  overflow-x: auto;
  word-break: break-word;
  white-space: pre-wrap;
}

select, .form-select, input, .form-control, textarea {
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box;
}

.form-select {
  text-overflow: ellipsis;
}

/* Fluid Responsive Typography Tokens */
:root {
  --fluid-h1: clamp(1.85rem, 4.8vw + 0.5rem, 3.75rem);
  --fluid-h2: clamp(1.5rem, 3.4vw + 0.4rem, 2.75rem);
  --fluid-h3: clamp(1.25rem, 2.4vw + 0.3rem, 1.85rem);
  --fluid-h4: clamp(1.1rem, 1.6vw + 0.2rem, 1.45rem);
  --fluid-body: clamp(0.9rem, 0.95vw + 0.1rem, 1.0625rem);
  --fluid-lead: clamp(1rem, 1.2vw + 0.15rem, 1.25rem);
  --touch-target-min: 44px;
}

.hero-title {
  font-size: var(--fluid-h1);
  line-height: 1.18;
  word-break: break-word;
  overflow-wrap: break-word;
}

.section-title {
  font-size: var(--fluid-h2);
  line-height: 1.24;
  word-break: break-word;
  overflow-wrap: break-word;
}

.page-banner-title,
.page-title {
  font-size: clamp(1.75rem, 4.2vw + 0.4rem, 3.25rem);
  line-height: 1.2;
  word-break: break-word;
  overflow-wrap: break-word;
}

/* --------------------------------------------------------------------------
   1. ULTRA-WIDE & LARGE DESKTOPS (1440px and above)
   -------------------------------------------------------------------------- */
@media (min-width: 1440px) {
  .container, .container-lg, .container-xl, .container-xxl {
    max-width: 1360px;
  }

  .hero-section {
    padding: 6rem 0 5rem;
  }

  .hero-editorial {
    padding: 7rem 0 6rem;
  }
}

/* --------------------------------------------------------------------------
   2. STANDARD DESKTOPS & LAPTOPS (1200px - 1439.98px)
   -------------------------------------------------------------------------- */
@media (min-width: 1200px) and (max-width: 1439.98px) {
  .navbar-nav .nav-link {
    padding: 0.5rem 0.6rem !important;
    font-size: 0.8875rem;
  }

  .navbar-brand {
    margin-right: 1.25rem;
  }

  .header-actions {
    gap: 0.45rem;
  }
}

/* --------------------------------------------------------------------------
   3. SMALL LAPTOPS & HORIZONTAL TABLETS (992px - 1199.98px)
   -------------------------------------------------------------------------- */
@media (min-width: 992px) and (max-width: 1199.98px) {
  .navbar-nav .nav-link {
    padding: 0.5rem 0.38rem !important;
    font-size: 0.8125rem;
    letter-spacing: -0.01em;
  }

  .navbar-brand {
    margin-right: 0.6rem;
    gap: 0.45rem;
  }

  .brand-icon-wrapper {
    width: 36px;
    height: 36px;
    font-size: 1.05rem;
  }

  .brand-main, .brand-sub {
    font-size: 1.15rem;
  }

  .header-actions {
    margin-left: 0.35rem;
    gap: 0.3rem;
  }

  .header-actions .auth-btn,
  .header-actions .auth-signin-btn,
  .header-actions .btn-sm {
    padding: 0 0.75rem !important;
    font-size: 0.785rem !important;
    height: 36px !important;
    min-height: 36px !important;
    max-height: 36px !important;
  }

  .mode-toggle,
  .rtl-toggle {
    width: 36px;
    height: 36px;
    font-size: 0.875rem;
  }

  .hero-section {
    padding: 4rem 0 3rem;
  }

  .pricing-card.featured {
    transform: none;
  }

  .stat-number {
    font-size: 2.2rem;
  }
}

/* --------------------------------------------------------------------------
   4. TABLETS & 2-IN-1 DEVICES (768px - 991.98px) — iPad Mini, iPad Air, Surface Pro 7
   -------------------------------------------------------------------------- */
@media (max-width: 991.98px) {
  /* Public Header & Collapsible Mobile Navigation (Overlay Dropdown - Zero Layout Shift) */
  .main-header {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1030;
    padding: 0;
    height: 70px;
    min-height: 70px;
    display: flex;
    align-items: center;
  }

  .main-header.scrolled {
    height: 64px;
    min-height: 64px;
  }

  .main-header .container {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .navbar {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 !important;
  }

  .navbar-toggler {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    cursor: pointer;
  }

  /* Overlay Dropdown Collapse */
  .navbar-collapse {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    width: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1rem;
    box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.22), 0 0 0 1px rgba(0, 0, 0, 0.05);
    max-height: calc(100vh - 84px);
    max-height: calc(100dvh - 84px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    z-index: 1050;
  }

  .navbar-collapse.collapsing {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    width: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1rem;
    box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.22), 0 0 0 1px rgba(0, 0, 0, 0.05);
    z-index: 1050;
    transition: height 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Prevent background scrolling when mobile menu is open */
  body.mobile-nav-open {
    overflow: hidden !important;
  }

  .navbar-nav {
    margin-bottom: 0.75rem !important;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.65rem 0.85rem !important;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .nav-link:hover {
    background-color: var(--bg-surface-soft);
  }

  .nav-link.active::before,
  .nav-link.active::after {
    display: none;
  }

  /* Mobile Nested Dropdowns */
  .dropdown-menu {
    border: 1px solid var(--border-subtle) !important;
    box-shadow: none !important;
    background-color: var(--bg-surface-soft) !important;
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    position: static !important;
    transform: none !important;
    float: none;
  }

  .dropdown-item {
    padding: 0.6rem 0.85rem;
    min-height: 40px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
  }

  /* Header Actions inside Mobile Navigation Drawer */
  .header-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-top: 1rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    width: 100%;
  }

  .header-actions .auth-btn,
  .header-actions .auth-signin-btn {
    flex: 1;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center;
    padding: 0 1rem !important;
    height: 44px !important;
    min-height: 44px !important;
    font-size: 0.875rem !important;
  }

  .mode-toggle,
  .rtl-toggle {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Hero Section */
  .hero-section {
    padding: 3.5rem 0 2.75rem;
    text-align: center;
  }

  .hero-buttons {
    justify-content: center;
    gap: 0.85rem;
  }

  .floating-badge {
    display: none;
  }

  .hero-editorial {
    min-height: auto;
    padding: 4.5rem 0 3.5rem;
    text-align: left;
  }

  .hero-editorial-bg {
    width: 100%;
    opacity: 0.12;
    mask-image: none;
    -webkit-mask-image: none;
  }

  /* Stats Section */
  .stat-item {
    border-right: none !important;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem 0;
  }

  .stat-item:last-child {
    border-bottom: none;
  }

  /* Grid Layouts & Cards */
  .horizontal-project-card .row {
    flex-direction: column !important;
  }

  .horizontal-project-card img {
    min-height: 240px !important;
    max-height: 320px !important;
    width: 100%;
    object-fit: cover;
  }

  .service-card,
  .process-step-card,
  .pricing-card,
  .blog-card,
  .team-card,
  .material-spec-card {
    margin-bottom: 1.5rem;
  }

  .pricing-card.featured {
    transform: none;
  }

  /* CTA Banner */
  .cta-banner {
    padding: 3rem 1.75rem;
    text-align: center;
  }

  .cta-buttons {
    justify-content: center;
    margin-top: 1.5rem;
  }

  /* Interactive Tools & Stages */
  .room-visualizer-stage {
    aspect-ratio: 16 / 10;
    min-height: 280px;
    height: auto;
  }

  .color-studio-container {
    padding: 1.5rem;
  }

  /* Grid Gutter Scaling for Tablets */
  .row.g-5 {
    --bs-gutter-x: 1.75rem;
    --bs-gutter-y: 1.75rem;
  }
}

/* --------------------------------------------------------------------------
   5. MOBILE LANDSCAPE, PHABLETS & DUAL SCREENS (576px - 767.98px)
   Surface Duo, Galaxy Z Fold (unfolded), iPhone Plus/Max landscape
   -------------------------------------------------------------------------- */
@media (max-width: 767.98px) {
  .section-subtitle {
    font-size: 0.95rem;
  }

  .btn-lg {
    padding: 0.75rem 1.35rem;
    font-size: 0.9375rem;
    min-height: 44px;
  }

  .comparison-slider-container {
    aspect-ratio: 4 / 3;
    width: 100%;
  }

  .calculator-box {
    padding: 1.25rem;
  }

  .calc-total-amount {
    font-size: 2rem;
  }

  .filter-btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: center;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    min-height: 40px;
  }

  /* Modals */
  .modal-dialog {
    margin: 0.75rem auto;
    max-width: 94vw;
  }

  .modal-body {
    padding: 1.25rem;
    max-height: 75vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Toast Notifications */
  .toast-container {
    left: 0.85rem !important;
    right: 0.85rem !important;
    bottom: 1rem !important;
    max-width: none;
    width: auto;
  }

  .custom-toast {
    width: 100% !important;
  }

  /* Grid Gutter Scaling for Mobile Landscape */
  .row.g-5 {
    --bs-gutter-x: 1.25rem;
    --bs-gutter-y: 1.5rem;
  }
  .row.g-4 {
    --bs-gutter-x: 1.25rem;
    --bs-gutter-y: 1.25rem;
  }
}

/* --------------------------------------------------------------------------
   6. STANDARD & COMPACT SMARTPHONES (360px - 575.98px)
   iPhone SE, XR, 12 Pro, 14/15/16 Pro Max, Pixel 7/8/9/10, Galaxy S8+, S20 Ultra
   -------------------------------------------------------------------------- */
@media (max-width: 575.98px) {
  body {
    font-size: 14.5px;
  }

  .container,
  .container-fluid {
    padding-left: 1rem !important;
    padding-right: 1rem !important;
  }

  /* Grid Gutter Scaling for Mobile Smartphones */
  .row.g-5,
  .row.g-4 {
    --bs-gutter-x: 1rem;
    --bs-gutter-y: 1.25rem;
  }

  /* Header Branding & Sizing */
  .main-header {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1030;
    padding: 0;
    height: 64px;
    min-height: 64px;
  }

  .navbar-collapse,
  .navbar-collapse.collapsing {
    top: calc(100% + 6px);
    max-height: calc(100vh - 76px);
    max-height: calc(100dvh - 76px);
    padding: 1.15rem 0.85rem;
  }

  .navbar-brand {
    gap: 0.4rem;
    margin-right: 0;
  }

  .brand-icon-wrapper {
    width: 34px;
    height: 34px;
    font-size: 1rem;
  }

  .brand-main, .brand-sub {
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }

  .header-actions {
    gap: 0.4rem;
  }

  .mode-toggle,
  .rtl-toggle {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    font-size: 0.95rem;
  }

  .header-actions .auth-btn,
  .header-actions .auth-signin-btn,
  .header-actions .btn-sm {
    padding: 0 0.85rem !important;
    font-size: 0.8125rem !important;
    height: 40px !important;
    min-height: 40px !important;
  }

  /* Hero Section */
  .hero-section {
    padding: 2.75rem 0 2rem;
  }

  .hero-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.5rem !important;
  }

  .hero-buttons {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0.75rem;
  }

  .hero-buttons .btn {
    width: 100%;
    min-height: 46px;
    justify-content: center;
  }

  .hero-editorial {
    padding: 3rem 0 2.5rem;
  }

  .hero-editorial .hero-buttons .btn {
    width: 100%;
  }

  /* Before / After Slider */
  .comparison-slider-container {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
  }

  .comparison-handle-btn {
    width: 38px;
    height: 38px;
    font-size: 0.85rem;
  }

  .comparison-badge {
    padding: 0.25rem 0.55rem;
    font-size: 0.7rem;
    top: 0.75rem;
  }

  .comparison-badge-before { left: 0.75rem; }
  .comparison-badge-after { right: 0.75rem; }

  /* Room Visualizer & Interactive Studio */
  .color-studio-container {
    padding: 1rem !important;
    border-radius: var(--radius-lg);
  }

  .room-visualizer-stage {
    aspect-ratio: 16 / 10;
    min-height: 230px;
    height: auto;
    border-radius: var(--radius-md);
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
  }

  .visualizer-overlay-info {
    left: 0.65rem !important;
    right: 0.65rem !important;
    bottom: 0.65rem !important;
    max-width: calc(100% - 1.3rem) !important;
    padding: 0.5rem 0.75rem !important;
    box-sizing: border-box;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .color-swatches-grid {
    gap: 0.4rem;
  }

  /* Swatch button maintains vertical layout on mobile */
  .color-swatch-btn {
    width: 100%;
    padding: 0.75rem 0.9rem;
    gap: 0.85rem;
    margin-bottom: 0.65rem;
  }

  /* Cards */
  .service-card,
  .testimonial-card,
  .blog-card,
  .team-card,
  .material-spec-card {
    padding: 1.25rem;
  }

  .project-card-overlay {
    padding: 1.25rem 1rem 1rem 1rem;
  }

  .project-card .project-title {
    font-size: 1.125rem;
  }

  .pricing-card {
    padding: 1.75rem 1.15rem;
  }

  /* Form & Auth Containers */
  .auth-card-compact,
  .quote-form-card,
  .contact-form-card {
    padding: 1.5rem 1.15rem;
    border-radius: var(--radius-lg);
    width: 100%;
  }

  .form-control,
  .form-select {
    font-size: 0.9rem;
    padding: 0.65rem 0.85rem;
    min-height: 44px;
  }

  .auth-card-compact .btn-submit-compact {
    width: 100%;
    min-height: 46px;
  }

  /* Social Auth Button Group */
  .social-auth-btn {
    padding: 0.6rem 0.75rem;
    min-height: 44px;
    font-size: 0.84rem;
  }

  /* CTA Banner */
  .cta-banner {
    padding: 2.25rem 1.25rem;
    border-radius: var(--radius-lg);
  }

  .cta-banner .cta-buttons {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0.75rem;
  }

  .cta-banner .cta-buttons .btn {
    width: 100%;
    min-height: 46px;
    justify-content: center;
  }

  /* 404 Error Page */
  .error-404-section {
    padding: 2.5rem 1rem;
  }

  .error-404-btn-group {
    flex-direction: column;
    width: 100%;
    gap: 0.65rem;
  }

  .error-404-btn-group .btn {
    width: 100%;
    min-height: 46px;
  }

  /* Footer */
  .main-footer {
    padding-top: 3rem;
  }

  .footer-bottom {
    text-align: center;
    padding: 1.25rem 0;
    margin-top: 2.5rem;
  }

  .footer-bottom .row {
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-social-links {
    justify-content: center;
    margin-top: 1rem;
    gap: 0.65rem;
  }

  .footer-social-btn {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
  }
}

/* --------------------------------------------------------------------------
   7. MICRO SCREENS & FOLDABLES (≤ 359.98px down to 280px)
   Samsung Galaxy Z Fold 5 (280px folded), Micro Smart Watches & Handhelds
   -------------------------------------------------------------------------- */
@media (max-width: 359.98px) {
  body {
    font-size: 13.5px;
  }

  .container,
  .container-fluid {
    padding-left: 0.75rem !important;
    padding-right: 0.75rem !important;
  }

  /* Ultra-compact Header */
  .main-header {
    padding: 0;
    height: 58px;
    min-height: 58px;
  }

  .navbar-collapse,
  .navbar-collapse.collapsing {
    top: calc(100% + 4px);
    max-height: calc(100vh - 68px);
    max-height: calc(100dvh - 68px);
    padding: 1rem 0.75rem;
  }

  .navbar-brand {
    gap: 0.3rem;
  }

  .brand-icon-wrapper {
    width: 30px;
    height: 30px;
    font-size: 0.875rem;
  }

  .brand-main, .brand-sub {
    font-size: 0.95rem;
  }

  .navbar-toggler {
    padding: 0.25rem;
    font-size: 1.25rem;
  }

  .hero-section {
    padding: 2rem 0 1.5rem;
  }

  .hero-buttons .btn {
    font-size: 0.8125rem;
    padding: 0.55rem 0.85rem;
  }

  .btn {
    padding: 0.55rem 0.85rem;
    font-size: 0.8125rem;
  }

  .stat-number {
    font-size: 1.75rem;
  }

  .stat-card {
    padding: 0.75rem 0.65rem;
  }

  .stat-value {
    font-size: 1.3rem;
  }

  /* Stack Social Buttons vertically if width is < 320px */
  .social-auth-row,
  .row:has(.social-auth-btn) {
    flex-direction: column !important;
    gap: 0.5rem;
  }

  .row:has(.social-auth-btn) > div {
    width: 100% !important;
  }

  .social-auth-btn {
    width: 100%;
    justify-content: center;
  }

  /* Swatch button maintains fluid vertical card on micro screens */
  .color-swatch-btn {
    width: 100%;
    padding: 0.65rem 0.75rem;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }
  .color-dot {
    width: 34px;
    height: 34px;
    min-width: 34px;
    min-height: 34px;
  }

  .color-studio-container {
    padding: 0.75rem !important;
  }

  .room-visualizer-stage {
    aspect-ratio: 16 / 10;
    min-height: 200px;
    height: auto;
    width: 100%;
    max-width: 100%;
  }

  .visualizer-overlay-info {
    left: 0.45rem !important;
    right: 0.45rem !important;
    bottom: 0.45rem !important;
    max-width: calc(100% - 0.9rem) !important;
    padding: 0.4rem 0.6rem !important;
  }

  .selected-color-name {
    font-size: 0.875rem !important;
  }

  .selected-color-hex {
    font-size: 0.75rem !important;
  }

  /* Grid Gutter Scaling for Micro Screens */
  .row.g-5,
  .row.g-4,
  .row.g-3 {
    --bs-gutter-x: 0.75rem;
    --bs-gutter-y: 1rem;
  }
}

/* --------------------------------------------------------------------------
   8. ACCESSIBILITY & MOTION PREFERENCES
   -------------------------------------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
